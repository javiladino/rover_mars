# ============================================================
# Rover Mars — Variables de entorno
# Copiar a `.env` (no versionado) y ajustar valores reales.
#   cp .env.example .env
# ============================================================

# ── PostgreSQL / PostGIS ────────────────────────────────────
POSTGRES_USER=rover
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=rover_mars

# ── Airflow ──────────────────────────────────────────────────
# Generar una clave nueva con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme_generate_your_own_fernet_key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_airflow_admin

# ── MinIO (local) / S3 (AWS) ────────────────────────────────
# En local (MinIO): MINIO_ENDPOINT=http://minio:9000, MINIO_SECURE=false
# En AWS (S3 real):  MINIO_ENDPOINT=s3.amazonaws.com, MINIO_SECURE=true
MINIO_ENDPOINT=http://minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
AWS_REGION=us-east-1

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin

# ── JupyterHub ───────────────────────────────────────────────
JUPYTER_TOKEN=changeme_jupyter_token

# ── NASA API (opcional) ─────────────────────────────────────
NASA_API_KEY=DEMO_KEY

# ── Simulación ───────────────────────────────────────────────
SIMULATION_SOL_START=1
SIMULATION_INTERVAL_SEC=30
JEZERO_LAT=18.4447
JEZERO_LON=77.4508

# ── DSN Receiver ─────────────────────────────────────────────
DSN_STATION=Goldstone
LIGHT_DELAY_MIN_MIN=3
LIGHT_DELAY_MAX_MIN=22

# ── AWS (solo si se despliega con docker-compose.aws.yml — ver
#    docs/GUIA_IMPLEMENTACION_MODERN_DATA_STACK.md, Fase 4) ──────────────
# No poner credenciales reales aquí; usar `aws configure` / variables de
# entorno de shell o SSM Parameter Store. Los valores de AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / RDS_* se obtienen de `terraform output` tras
# aplicar infra/aws/ y NO deben commitearse en un .env real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RDS_HOST=
RDS_ENDPOINT=
RDS_USER=rover
RDS_PASSWORD=
SNS_ALERTS_TOPIC_ARN=

# Nombres reales de los buckets creados por infra/aws/s3.tf
# (terraform output s3_buckets). En local (MinIO) se dejan los valores
# por defecto "mastcamz-*" definidos en el código.
S3_BUCKET_RAW=mastcamz-raw
S3_BUCKET_BRONZE=mastcamz-bronze
S3_BUCKET_SILVER=mastcamz-silver
S3_BUCKET_GOLD=mastcamz-gold
S3_BUCKET_PDS4=mastcamz-pds4
